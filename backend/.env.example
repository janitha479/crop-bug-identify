# Copy this file to .env and fill in values. NEVER commit the real .env.

# --- LLM (optional) ---
# Free-tier Google Gemini API key from https://aistudio.google.com/app/apikey
# If left blank, the chatbot falls back to template replies built from the knowledge base.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Model ---
# Path (relative to backend/) to the trained model. If the file is missing, the backend
# uses a mock model so the app still runs.
MODEL_PATH=model/pest_model.keras
CLASS_NAMES_PATH=model/class_names.json

# Confidence below this (0-1) is treated as "not sure" — the bot asks for a clearer photo
# and shows the top-3 candidates instead of asserting one answer.
CONFIDENCE_THRESHOLD=0.55

# --- Server ---
FLASK_DEBUG=1
PORT=5000
# Comma-separated allowed origins for CORS (frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
